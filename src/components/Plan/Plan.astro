---
import "./_plan.scss";
import PlanCard from "@/components/PlanCard/PlanCard.astro";
---

<section class="plan">
  <div class="plan__container container">
    <div class="plan__text">
      <h1 class="plan__title title--h1">Choose Your Plan</h1>
      <div class="plan__desc desc">
        Whether you want to get organized, keep your personal life on track, or
        boost workplace productivity, Evernote has the right plan for you.
      </div>
    </div>

    <PlanCard />

  </div>
</section>
